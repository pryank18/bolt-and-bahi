# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — it will never be committed.
#
# Get these from your own Supabase project:
# Project Settings -> API -> Project URL / anon public key
# (The anon key is safe to expose client-side by design — Row Level
# Security policies in supabase/schema.sql are what actually enforce
# access, not secrecy of this key. Never use the service_role key here.)
#
# NOTE: these are not wired up to the app yet. The app currently runs
# entirely on local browser storage (see src/storagePolyfill.js) — the
# Supabase connection is the next phase of work. See ../README.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Your Anthropic API key is NOT set here — it's entered directly in the
# app's Settings tab at runtime and stored only in your browser's local
# storage, never in a build-time env var or committed file. This is the
# "bring your own key" pattern: each person who runs this app supplies
# their own key, used only for their own requests.
