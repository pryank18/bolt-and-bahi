# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — it will never be committed.
#
# Get these from your own Supabase project:
# Project Settings -> API -> Project URL / anon public key
# (The anon key is safe to expose client-side by design — Row Level
# Security policies in schema.sql are what actually enforce access,
# not secrecy of this key. Never use the service_role key here.)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI features (ARA assistant, fabric photo-fill, dashboard insights,
# reminder drafting) currently only work when this app is run as a
# Claude.ai artifact, where API access is handled automatically.
# Running this app outside Claude.ai (e.g. after the planned Vite
# migration) will need a "bring your own Anthropic API key" field
# added to Settings before these features work standalone — that
# wiring has not been built yet. See README.md "Roadmap".
